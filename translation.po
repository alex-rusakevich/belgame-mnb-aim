msgid "Здравствуй, {playername}. Я {s1}. Спасибо за помощь, надеюсь, мы еще встретимся!"
msgstr "Здравствуй, {playername}. Я {s1}. Спасибо за помощь, надеюсь, мы еще встретимся!"


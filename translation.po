#, fuzzy
msgid "dlga_oim_tatarin_first_talk_1:oim_tatarin_first_talk_2"
msgstr "Чего тебе?"

#, fuzzy
msgid "dlga_oim_tatarin_first_talk_2:oim_tatarin_first_talk_3"

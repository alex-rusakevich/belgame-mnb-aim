msgstr "{s43}"

# <English>Is there no way to avoid this battle? I don't want to fight with
# you.</English>
#, fuzzy
msgctxt "dlga_party_encounter_lord_hostile_attacker_2:party_encounter_offer_dont_fight"
msgid "Нельзя ли как-то избежать этой битвы? У меня нет желания сражаться с тобой."
msgstr "Ці нельга неяк пазбегнуць гэтай бітвы? У мяне няма жадання змагацца з табой."

# <English>Don't attack! We surrender.</English>
msgctxt "dlga_party_encounter_lord_hostile_attacker_2:close_window"
msgid "Не атакуйте! Мы сдаемся."
msgstr "Не атакуйце! Мы здаемся."

# <English>We will fight you to the end!</English>
#, fuzzy
msgctxt "dlga_party_encounter_lord_hostile_attacker_2:close_window.1"
msgid "Мы будем сражаться до конца!"
msgstr "Мы будзем змагацца да канца!"

# <English>Hmm, I owe you a favor now, don't I... Very well, I will let you
# pass unharmed -- just this once.</English>
#, fuzzy
msgctxt "dlga_party_encounter_offer_dont_fight:close_window"
msgid "В конце концов, я у тебя в долгу. Ну ладно. На сей раз я тебя отпущу."
msgstr "Урэшце, я ў цябе ў даўгу. Ну добра. На гэты раз я цябе адпушчу."

# <English>Ha-ha. But I wish to fight with you.</English>
#, fuzzy
msgctxt "dlga_party_encounter_offer_dont_fight:close_window.1"
msgid "Ха-ха! Зато у меня кулаки чешутся!"
msgstr "Ха-ха! Затое ў мяне кулакі свярбяць!"

# <English>Our first task is to seize a fortress. Then, others will join

#, fuzzy
msgctxt "str_lord_follow_refusal_pitiless"
msgid "Дворяне вроде меня не следуют за такими, как ты, {господин/госпожа}."
msgstr "Дворяне вроде меня не следуют за такими, как ты, {господин/госпожа}."

# <English>First show me that you are the type of {man/woman} who will not

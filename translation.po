#, fuzzy
msgctxt "qstr_OiM_{s9}_asked_you_to_"
msgid "{s9} пойдет с вами, если вы приведете с собой не меньше десятка солдат... "
msgstr "{s9} пойдзе з вамі, калі вы прывядзеце з сабой не менш за дзесятак салдат... "

# <English>{s9} asked you to plunder {s10}.</English>
#, fuzzy
msgctxt "qstr_OiM_{s9}_asked_you_to_b"
msgid "{s9} попросил вас разграбить {s10}."
msgstr "{s9} папрасіў вас разрабаваць {s10}."

# <English>{s9} said that he shall speak to the Hetman on your

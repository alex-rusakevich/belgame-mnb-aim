#, fuzzy
msgctxt "dlga_supported_pretender_talk:oim_getman_ask_add_info_dlg"
msgid "Ну что, князь Януш, расскажешь мне о Черном Гетмане?"
msgstr "Ну што, князь Януш, раскажаш мне пра чорнага гетмана?"

# <English>I have brought the prisoner.</English>
#, fuzzy

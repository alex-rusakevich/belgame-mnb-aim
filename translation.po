#, fuzzy
msgid ""
"dlga_oim_trakai_icon_town_dweller_riga_talk_ugovor_neg_2:oim_trakai_icon_town_dweller_riga_talk_2_loop_back"
msgstr "Ну ладно..."

#, fuzzy
msgid ""
"dlga_oim_trakai_icon_town_dweller_riga_talk_7:oim_trakai_icon_town_dweller_riga_talk_siloy"
msgstr "Забрать икону силой."

#, fuzzy
msgid ""
"dlga_oim_trakai_icon_town_dweller_riga_talk_siloy:oim_trakai_icon_town_dweller_riga_talk_siloy_1"

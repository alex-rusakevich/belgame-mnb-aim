#, fuzzy
msgctxt "str_lord_follow_refusal_upstanding"
msgid "Сначала докажи, что за тобой и впрямь стоит идти, а там посмотрим."
msgstr "Сначала докажи, что за тобой и впрямь стоит идти, а там посмотрим."


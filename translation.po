#, fuzzy
msgctxt "qstr_OiM_{s9}_skazal_chto"
msgid "{s9} сказал, что замолвит за вас словечко перед гетманом."
msgstr "{s9} сказаў, што замовіць за вас слоўца перад гетманам."

# <English>{s9} asked you to take a horse to {s10}.</English>
#, fuzzy
msgctxt "qstr_OiM_{s9}_asked_to_br"
msgid "{s9} попросил вас доставить коня {s10}."
msgstr "{s9} папрасіў вас даставіць каня {s10}."

# <English>{s9} asked you to collect the money from {s10} and bring it to
# Hmelnitski.</English>
#, fuzzy
msgctxt "qstr_As_{s9}_said_to_get_"
msgid "{s9} попросил вас забрать деньги из {s10} и отвезти их Хмельницкому."
msgstr "{s9} папрасіў вас забраць грошы з {s10} і адвезці іх Хмяльніцкаму."

# <English>{s9} gave you a recommendation for {s10}.</English>
#, fuzzy
msgctxt "qstr_As_{s9}_give_you_a_r"
msgid "{s9} дал вам рекомендацию к {s10}."
msgstr "{s9} даў вам рэкамендацыю да {s10}."

# <English>{s9} asked you to plunder three villages of the Polish

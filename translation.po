#, fuzzy
msgctxt "dlga_lord_give_order_disband_army_2:lord_pretalk"
msgid "По некотором размышлении, лучше пока держаться вместе."
msgstr "Па некаторым разважанні, лепш пакуль трымацца разам."

# <English>Very well. I will inform our forces that they are released from

#, fuzzy
msgctxt "str_lord_follow_refusal_sadistic"
msgid "Нет уж! Лучше ты иди за мной, как дворняжка за хозяином."
msgstr "Нет уж! Лучше ты иди за мной, как дворняжка за хозяином."

# <English>Um, I am a bit pressed with errands right now. Perhaps at a later

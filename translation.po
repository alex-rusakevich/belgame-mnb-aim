#, fuzzy
msgctxt "str_unnecessary_attack_upstanding"
msgid "Если ты хочешь боя, {господин/госпожа}, то ты его получишь, но сперва подумай как следует."
msgstr "Если ты хочешь боя, {господин/госпожа}, то ты его получишь, но сперва подумай как следует."

# <English>As you wish. Prepare to die!</English>
#, fuzzy
msgctxt "str_lord_challenged_default"
msgid "Как хочешь. Готовься к смерти!"
msgstr "Как хочешь. Готовься к смерти!"

# <English>So be it. Defend yourself!</English>
#, fuzzy
msgctxt "str_lord_challenged_martial"
msgid "Так и быть. Защищайся!"
msgstr "Так и быть. Защищайся!"

# <English>You lowly dog! I'll crush you!</English>
#, fuzzy
msgctxt "str_lord_challenged_quarrelsome"

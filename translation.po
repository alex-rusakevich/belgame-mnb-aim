msgid "."
msgstr "."

# <English>I will do that.</English>
msgctxt "dlga_lord_give_order_answer_2:close_window"
msgid "Я это сделаю."
msgstr "Я зраблю гэта."

# <English>I am sorry, it is not possible for me to do that.</English>
#, fuzzy
msgctxt "dlga_lord_give_order_answer_2:lord_pretalk"
msgid "Мне очень жаль, но это невозможно."
msgstr "Мне вельмі шкада, але гэта немагчыма."

# <English>I wish to start a new campaign. Let us assemble the army
# here.</English>
#, fuzzy
msgctxt "dlga_lord_talk:lord_give_order_call_to_arms_verify"
msgid "Я собираюсь в новый поход. Давай соберем здесь армию."
msgstr "Я збіраюся ў новы паход. Давай збярэм тут войска."

# <English>You wish to summon forces for a new campaign?</English>
#, fuzzy
msgctxt "dlga_lord_give_order_call_to_arms_verify:lord_give_order_call_to_arms_verify_2"
msgid "Ты хочешь собрать войска для новой кампании?"
msgstr "Вы хочаце сабраць войскі для новай кампаніі?"

# <English>Yes. We must gather all our forces, then march on the
# enemy.</English>
#, fuzzy
msgctxt "dlga_lord_give_order_call_to_arms_verify_2:lord_give_order_call_to_arms"
msgid "Да, надо собрать все наши силы, прежде чем мы выступим на врага."
msgstr "Так, трэба сабраць усе нашы сілы, перш чым мы выступім на ворага."

# <English>On second thought, it won't be necessary to summon
# everyone.</English>
#, fuzzy
msgctxt "dlga_lord_give_order_call_to_arms_verify_2:lord_pretalk"
msgid "По некотором размышлении, нет необходимости призывать всех и каждого."
msgstr "Па некаторым разважанні, няма неабходнасці заклікаць усіх і кожнага."

# <English>Very well, then. I shall send messengers and tell everyone to
# gather here.</English>
#, fuzzy
msgctxt "dlga_lord_give_order_call_to_arms:lord_pretalk"
msgid "Ладно. Я разошлю гонцов с приказом прибыть сюда."
msgstr "Добра. Я разашлю ганцоў з загадам прыбыць сюды."

# <English>I wish to end the campaign and allow everyone to return
# home.</English>
#, fuzzy
msgctxt "dlga_lord_talk:lord_give_order_disband_army_verify"
msgid "Я хочу завершить эту кампанию и распустить всех по домам."
msgstr "Я хачу завяршыць гэтую кампанію і распусціць усіх па дамах."

# <English>You want to end the current campaign and release all our troops
# from duty?</English>
#, fuzzy
msgctxt "dlga_lord_give_order_disband_army_verify:lord_give_order_disband_army_2"
msgid "Ты хочешь закончить поход и отпустить отряды?"
msgstr "Ты хочаш скончыць паход і адпусціць атрады?"

# <English>Yes. We no longer need all of our forces here.</English>
#, fuzzy
msgctxt "dlga_lord_give_order_disband_army_2:lord_give_order_disband_army"
msgid "Да. Все силы здесь нам больше не требуются."
msgstr "Так. Усе сілы тут нам больш не патрабуюцца."

# <English>On second thought, it will be better if we stand together for

msgid "Мне нужно кое-что тебе сказать, {s5}."
msgstr "Мне трэба сёе-тое табе сказаць, {s5}."

# <English>{s5}</English>
msgctxt "dlga_companion_quitting:companion_quitting_2"
msgid "{s5}"
msgstr "{s5}"

# <English>To tell you the truth, {s21}.</English>
#, fuzzy
msgctxt "dlga_companion_quitting_2:companion_quitting_response"
msgid "Скажу все, как есть, {s21}."
msgstr "Скажу ўсё, як ёсць, {s21}."

# <English>Very well. Be off then.</English>
#, fuzzy
msgctxt "dlga_companion_quitting_response:companion_quitting_yes"
msgid "Хорошо, можешь идти."
msgstr "Добра, можаш ісці."


#, fuzzy
msgctxt "str_npc10_2ary_morality_speech"
msgid "[Нет вторичных моральных норм]"
msgstr "[Няма другасных маральных нормаў]"

# <English>[No secondary moral code]</English>
#, fuzzy
msgctxt "str_npc11_2ary_morality_speech"
msgid "[Нет вторичных моральных норм]"
msgstr "[Няма другасных маральных нормаў]"

# <English>[No secondary moral code]</English>
#, fuzzy
msgctxt "str_npc12_2ary_morality_speech"
msgid "[Нет вторичных моральных норм]"
msgstr "[Няма другасных маральных нормаў]"

# <English>You can allow {s21} with ease? I fear we will not get along so
# well.</English>
#, fuzzy
msgctxt "str_npc13_2ary_morality_speech"
msgid "Ты легко можешь {s21}? Боюсь, мы не поладим."
msgstr "Ты лёгка можаш {s21}? Баюся, мы не паладзім."

# <English>[No secondary moral code]</English>
#, fuzzy
msgctxt "str_npc14_2ary_morality_speech"
msgid "[Нет вторичных моральных норм]"
msgstr "[Няма другасных маральных нормаў]"


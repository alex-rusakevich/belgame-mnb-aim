#, fuzzy
msgctxt "dlga_oim_get_feast_supplies_finish:village_elder_pretalk"
msgid "К сожалению, у тебя недостаточно {s1}. Из-за этого мы не сможем начать праздник."
msgstr "На жаль, у цябе недастаткова {s1}. Таму мы не зможам пачаць свята."

# <English>Thank you for the reward. I am happy I was of help.</English>
#, fuzzy
msgctxt "dlga_oim_get_feast_supplies_succeeded:village_elder_pretalk"
msgid "Спасибо за награду. Хорошо, что мне удалось помочь вам."

#, fuzzy
msgctxt "dlga_companion_quitting_no_confirm:companion_quitting_yes"
msgid "Нет, конечно же, шучу. Можешь идти, если хочешь."
msgstr "Не, вядома ж, жартую. Можаш ісці, калі хочаш."

# <English>Then this is farewell. Perhaps we shall meet again,
# {playername}.</English>
#, fuzzy
msgctxt "dlga_companion_quitting_yes:close_window"
msgid "Тогда прощай. Может быть, еще свидимся, {playername}."
msgstr "Тады Бывай. Можа быць, яшчэ пабачымся, {playername}."

# <English>Hmm. I suppose I'll stay, then.</English>
#, fuzzy
msgctxt "dlga_companion_quitting_no_confirmed:close_window"
msgid "Хм. Думаю, в таком случае я останусь."
msgstr "Хм. Думаю, у такім выпадку я застануся."


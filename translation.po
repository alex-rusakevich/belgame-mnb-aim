#, fuzzy
msgctxt "dlga_player_siege_ask_leave_unmolested_reject:close_window"
msgid "Тогда мы будем защищать эту крепость до последней капли крови. Нам больше не о чем говорить."
msgstr "Тогда мы будем защищать эту крепость до последней капли крови. Нам больше не о чем говорить."

# <English>I am in your debt for freeing me, my friend. You have my eternal
# gratitude!</English>
#, fuzzy
msgctxt "dlga_start:freed_lord_answer"
msgid "Спасибо, что освободил меня, друг мой! Я перед тобой в долгу!"
msgstr "Спасибо, что освободил меня, друг мой! Я перед тобой в долгу!"

# <English>You're not going anywhere, 'friend'. You're my prisoner

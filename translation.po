#, fuzzy
msgctxt "dlga_pretender_quit_rebel_confirm:pretender_quit_rebel_confirm_2"
msgid "{playername}, ты не можешь покинуть меня в такой момент. Ты что, серьезно?"
msgstr "{playername}, ты не можаш пакінуць мяне ў такі момант. Ты што, сур'ёзна?"

# <English>No, I speak the truth. I fear that I cannot support you any

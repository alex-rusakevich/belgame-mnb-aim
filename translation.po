#, fuzzy
msgctxt "dlga_pretender_quit_rebel_confirm_3:pretender_quit_rebel_confirm_4"
msgid "Ты уверен? Я никогда не прощу тебя, если бросишь меня в таком положении."
msgstr "Ты ўпэўнены? Я ніколі не дарую цябе, калі кінеш мяне ў такім становішчы."

# <English>Yes, I am quite sure.</English>
#, fuzzy
msgctxt "dlga_pretender_quit_rebel_confirm_4:pretender_quit_rebel"
msgid "Абсолютно уверен."
msgstr "Абсалютна ўпэўнены."


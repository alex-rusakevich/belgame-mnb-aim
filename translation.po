msgid ""
"str_it_is_still_early_in_the_caravan_season_so_we_have_seen_little_tradings42"
msgstr ""
"Караванный сезон только начинается, так что торговать пока что почти "
"нечем.{s42}"

msgid "str_there_has_been_very_little_trading_activity_here_recentlys42"
msgstr "В последнее время торговля тут почти заглохла.{s42}"

msgid "str_there_has_some_trading_activity_here_recently_but_not_enoughs42"
msgstr "В последнее время тут торговали, но очень неактивно.{s42}"

msgid ""
"str_there_has_some_trading_activity_here_recently_but_the_roads_are_dangerouss42"
msgstr "В последнее время тут торговали, но дороги сейчас очень опасны.{s42}"

msgid "str_the_roads_around_here_are_very_dangerouss42"
msgstr "Дороги здесь очень опасны.{s42}"

msgid ""
"str_we_have_received_many_traders_in_town_here_although_there_is_some_danger_on_the_roadss42"

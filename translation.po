#, fuzzy
msgctxt "dlga_village_elder_mission_failed:village_elder_pretalk"
msgid "Жалко, жалко... Ну ничего, глядишь, еще что-нибудь придумаю."
msgstr "Шкада, шкада... Ну нічога, глядзіш, яшчэ што-небудзь прыдумаю."

# <English>Nay, {sir/madam}, you are already engaged in a task helping us. We

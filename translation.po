#, fuzzy
msgid "dlga_oim_getman_kozaks_service_dlg_1:oim_getman_kozaks_service_dlg_2"
msgstr "И кто же это такой?"

#, fuzzy
msgid "dlga_oim_getman_kozaks_service_dlg_2:oim_getman_kozaks_service_dlg_3"
msgstr ""
"Черный Гетман - это старинный пернач, выкованный из редкого металла. Если "

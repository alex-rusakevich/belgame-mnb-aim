#, fuzzy
msgctxt "str_unnecessary_attack_quarrelsome"
msgid "Тьфу! У меня нет времени на ерунду! А ну с дороги!"
msgstr "Тьфу! У меня нет времени на ерунду! А ну с дороги!"

# <English>I am in a merciful mood today. I will pretend that I did not hear
